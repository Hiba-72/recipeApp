{
  "name": "taktouka",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run api\" \"npm run client\"",
    "client": "npm start --prefix frontend",
    "api": "npm run dev --prefix worker",
    "test": "npm test --prefix frontend -- --watchAll=false",
    "install:all": "npm install && npm install --prefix worker && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "deploy": "npm run deploy --prefix worker"
  },
  "keywords": [
    "recipes",
    "react",
    "express",
    "mongodb",
    "spoonacular",
    "meal-planning"
  ],
  "author": "Hiba El Fachtali",
  "license": "MIT",
  "description": "Tells you what you can cook tonight, from what is already in your fridge. React + Express + MongoDB, with a quota-aware Spoonacular proxy.",
  "dependencies": {
    "concurrently": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hiba-72/recipeApp.git"
  },
  "engines": {
    "node": ">=18"
  }
}

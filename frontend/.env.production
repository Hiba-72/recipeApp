# Production build settings. Committed on purpose — nothing here is secret,
# and CRA only ever inlines REACT_APP_* vars, of which there are none.

# Source maps are 1.5 MB of the 1.9 MB build and are the main reason a CRA
# build runs out of memory on a 512 MB instance. The source is public on
# GitHub anyway, so there is nothing to protect by shipping them.
GENERATE_SOURCEMAP=false

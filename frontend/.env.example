# Where the Taktouka API lives.
#
# Local development: the Worker, served by `wrangler dev` on 8787.
# Production: the deployed Worker's URL, set in the Cloudflare Pages build
# settings rather than here — CRA bakes REACT_APP_* in at build time.
#
# This is NOT a secret. Anything REACT_APP_* is compiled into the bundle and
# readable by anyone who opens devtools, which is exactly why the Spoonacular
# key lives in the Worker instead.
REACT_APP_API_URL=http://localhost:8787

# Dev server port
PORT=3001

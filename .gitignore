# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
/build
/dist

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db
# Any local env file, whatever the suffix — .env.tmp and friends are just as
# sensitive as .env itself. The tracked templates and the production build
# settings stay.
.env*
!.env.example
!.env.production

# Editor and tooling scratch
*.log
logs/

# Cloudflare Workers.
# .dev.vars is what `wrangler dev` reads for local secrets — it holds the
# Spoonacular key and is NOT matched by the .env* rules above, which is easy
# to miss. Deployed secrets live in `wrangler secret put`, never in the repo.
.dev.vars
!.dev.vars.example
.wrangler/

# Scratch commit-message files.
.msg.tmp

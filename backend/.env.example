# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/RecipeFinder

# Port the API listens on
PORT=5000

# Spoonacular API key — get a free one at https://spoonacular.com/food-api
# Server-side only. This is never sent to the browser.
SPOONACULAR_API_KEY=your_key_here

# Browser origins allowed to call this API, comma separated.
# Leave empty in production when the server also serves the built frontend —
# same-origin requests need no entry here.
ALLOWED_ORIGINS=http://localhost:3001

# Force the captured offline sample instead of live API calls.
# Useful for seeing exactly what a visitor gets once the daily allowance runs
# out, without waiting for that to happen.
USE_FIXTURES=false
